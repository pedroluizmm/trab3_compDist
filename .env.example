# Este arquivo contem apenas configuracao publica, nenhuma senha.
# scripts/preparar.py cria .env e os tres segredos locais sem sobrescrever existentes.
COMPOSE_PROJECT_NAME=trabalho3-experimento
HTTP_PORT=8086
# Windows: www-data nos conteineres. Em macOS/Linux o preparador usa IDs locais.
LOCAL_UID=33
LOCAL_GID=33
SITE_URL=http://127.0.0.1:8086
